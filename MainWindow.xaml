<Window x:Class="SubtitleGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SubtitleGenerator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel VerticalAlignment="Center"
            HorizontalAlignment="Center">

            <TextBlock
                Width="500"
                TextWrapping="Wrap"
                Text="{Binding VideoPath}"/>

            <Button
                Content="영상 선택"
                Command="{Binding SelectVideoCommand}"/>

            <Button
                Content="음성 추출"
                Command="{Binding ExtractAudioCommand}" />
            <Button
                Content="자막 생성"
                Command="{Binding GenerateSubtitleCommand}" />
            
            
            <TextBlock
                Margin="0,20,0,0"
                FontWeight="Bold"
                Text="현재 상태" ></TextBlock>

            <TextBlock
                Margin="0,5,0,10"
                Text="{Binding Status}"> </TextBlock>

            <TextBlock
                FontWeight="Bold"
                Text="진행률" />

                <ProgressBar
        Width="300"
        Height="20"
        Minimum="0"
        Maximum="100"
        Value="{Binding Progress}" />

        </StackPanel>

        <StackPanel VerticalAlignment="Bottom"
                            HorizontalAlignment="Right">
            <Button Content="FFmpeg 버전확인"
                    Command="{Binding GetVersionCommand}">
            </Button>

            <Button
            Content="Whisper 테스트"
            Command="{Binding RunWhisperCommand}" />
        </StackPanel>

    </Grid>
</Window>
